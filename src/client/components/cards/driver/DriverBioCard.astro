---
import type { APIOutput } from '../../../services/client';
import Card from '../../Card.astro';

interface Props {
  data: APIOutput['drivers']['all'] extends (infer U)[] ? U : unknown;
}

const { data } = Astro.props;
---

<Card title={data.name}>
  <h4>{data.dob} &#183 {data.nationality.toLocaleUpperCase()}</h4>

  <p>First Grand Prix:</p>
  <p>Last Grand Prix:</p>

  <p>Best Result:</p>
  <p>Best Grid Position:</p>
</Card>
